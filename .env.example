# Safe Quote Upstream API Configuration (Server-Only — NEVER expose to client)
SALES_ARENA_API_URL=https://portal.thesafequote.com/api/sales-arena
SALES_ARENA_API_TOKEN=your_safe_quote_api_bearer_token_here

# PostgreSQL Database Configuration
DATABASE_URL=postgres://sales_arena_app:your_db_password_here@127.0.0.1:5432/sales_arena

# Business Timezone & Operational Mode
SALES_ARENA_TIMEZONE=America/New_York
SALES_ARENA_MODE=production

# Admin Security Key (Required in production for administrative writes and settings)
ADMIN_API_KEY=generate_a_secure_random_key_here
