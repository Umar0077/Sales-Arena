# Sales Arena — server environment. Copy to a root-only file (e.g. /etc/sales-arena/sales-arena.env, chmod 600).
# Every value here is server-only. Never put secrets in NEXT_PUBLIC_* variables.

# --- Safe Quote upstream API (read-only bearer token; unrelated to admin logins) ---
SALES_ARENA_API_URL=https://portal.thesafequote.com/api/sales-arena
SALES_ARENA_API_TOKEN=replace_with_rotated_safe_quote_token
# Max rows /recent-sales returns per request. A day that hits this cap may be truncated.
SAFEQUOTE_RECENT_SALES_LIMIT=50

# --- PostgreSQL (application database only) ---
DATABASE_URL=postgres://sales_arena_app:replace_with_db_password@127.0.0.1:5432/sales_arena

# --- Business clock ---
SALES_ARENA_TIMEZONE=America/New_York
SALES_ARENA_MODE=production

# --- Live sync worker (SSE + periodic reconciliation) ---
# On by default in production when DATABASE_URL and the token are set. Set false to pause.
# In development it only runs when explicitly set to true.
SALES_ARENA_SYNC_ENABLED=true
SALES_ARENA_RECONCILE_MINUTES=5

# --- Admin security ---
# Public origin of the site; used for the same-origin (CSRF) check on every write.
APP_ORIGIN=https://arena.example.com
# Cookies are Secure (__Host- prefix) in production. Only set false for a plain-HTTP staging preview.
# ADMIN_COOKIE_SECURE=false

# Admin accounts live in PostgreSQL (Argon2id). Create the first one with:
#   node --env-file=<this file> scripts/create-admin.mjs
